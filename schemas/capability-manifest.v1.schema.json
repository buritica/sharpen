{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharpen.dev/schemas/capability-manifest.v1.schema.json",
  "title": "Sharpen capability manifest v1",
  "description": "Declares agent- or tool-provided outcomes without binding them to a host command API.",
  "type": "object",
  "required": ["protocol_version", "provider", "capabilities"],
  "properties": {
    "protocol_version": {"const": "1"},
    "provider": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "agent": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["plan", "review", "imagine", "fix", "test", "lint", "typecheck", "ship"]
      }
    }
  },
  "additionalProperties": true
}
