# Shared editor defaults so formatting is consistent before biome even runs.
# Scaffolded by the `sdlc` plugin. Lives at the repo root as .editorconfig.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
