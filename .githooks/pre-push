#!/usr/bin/env bash
# sharpen repo's own pre-push: run the marketplace consistency check (version
# bumps, SKILL.md staleness, pi manifests) before anything leaves this clone.
# Host-agnostic: it catches every agent and a human alike, which the
# Claude-only scripts/pre-merge-check.sh hook cannot.
#
# Wire it once per clone: scripts/install-hooks.sh (sets core.hooksPath).
#
# Limit: the check reads the working tree, not the commits being pushed, so
# uncommitted edits can mask or cause a failure. Commit (or stash) first.
#
# core.hooksPath makes git ignore .git/hooks, so this hook then calls, in
# order:
#   1. the sdlc plugin's product pre-push (plugins/sdlc/scripts/pre-push.py,
#      arriving with the area 2 PR in the stack), through the chain line its
#      installer prints when core.hooksPath is set. A no-op until /sdlc:gate
#      has recorded `git config sharpen.sdlcScripts`; warn-only unless
#      `git config sharpen.prePush block`.
#   2. any other pre-push hook left in .git/hooks.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
# git feeds the refs being pushed on stdin; read it once and replay it from a
# file, so a chained hook that never reads stdin can't SIGPIPE this script.
PUSH_STDIN_FILE="$(mktemp)"
trap 'rm -f "$PUSH_STDIN_FILE"' EXIT
cat > "$PUSH_STDIN_FILE"

if ! python3 "$ROOT/scripts/check-marketplace.py"; then
  echo "pre-push: marketplace check failed; fix it before pushing." >&2
  exit 1
fi

dir=$(git config --get sharpen.sdlcScripts || true)
if [ -n "$dir" ] && [ -f "$dir/pre-push.py" ]; then
  python3 "$dir/pre-push.py" "$@" < "$PUSH_STDIN_FILE" || exit $?
fi

resolve() { python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"; }
CHAINED="$(git rev-parse --git-common-dir)/hooks/pre-push"
# Compare resolved files, not directories: .git/hooks/pre-push may be a
# symlink back to this script, and chaining to it would loop forever.
if [ -x "$CHAINED" ] && [ "$(resolve "$CHAINED")" != "$(resolve "$SELF")" ]; then
  "$CHAINED" "$@" < "$PUSH_STDIN_FILE"
fi
exit 0
